# Fased Podman environment
# Copy to deploy/containers/fased.podman.env.local and set FASED_GATEWAY_TOKEN
# or point FASED_PODMAN_ENV at your own private env file.
# This file can be used with:
#   FASED_PODMAN_ENV=/path/to/deploy/containers/fased.podman.env ./scripts/run-fased-podman.sh launch

# Required: gateway auth token. Generate with: openssl rand -hex 32
# Set this before running the container (or use run-fased-podman.sh which can generate it).
FASED_GATEWAY_TOKEN=

# Host port mapping (defaults; override if needed)
FASED_PODMAN_GATEWAY_HOST_PORT=18789
FASED_PODMAN_BRIDGE_HOST_PORT=18790

# Gateway bind (used by the launch script)
FASED_GATEWAY_BIND=lan

# Optional: model provider API keys
# OLLAMA_API_KEY=ollama-local
# GROQ_API_KEY=
