# FasedAgent gateway — Podman Quadlet (rootless)
# Installed by setup-podman.sh into fased's ~/.config/containers/systemd/
# {{FASED_HOME}} is replaced at install time.

[Unit]
Description=FasedAgent gateway (rootless Podman)

[Container]
Image=fased:local
ContainerName=fased
UserNS=keep-id
Volume={{FASED_HOME}}/.fased:/home/node/.fased
EnvironmentFile={{FASED_HOME}}/.fased/.env
Environment=HOME=/home/node
Environment=TERM=xterm-256color
PublishPort=18789:18789
PublishPort=18790:18790
Pull=never
Exec=node dist/index.js gateway --bind lan --port 18789

[Service]
TimeoutStartSec=300
Restart=on-failure

[Install]
WantedBy=default.target
