{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fased.ai/schemas/lifecycle-release-gate-receipt-v1.json",
  "title": "Fased lifecycle release gate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receipt", "receiptDigest"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "context",
        "authorizedActions",
        "candidate",
        "bindings",
        "gate",
        "result",
        "validity"
      ],
      "properties": {
        "kind": {
          "const": "fased-lifecycle-release-gate"
        },
        "context": {
          "const": "fased/lifecycle-release-gate"
        },
        "authorizedActions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["docker", "github-release", "stable", "tag", "version"]
          }
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "planDigest",
            "artifactDigest",
            "topologyDigest",
            "runnerDigest",
            "evaluationDigest"
          ],
          "properties": {
            "planDigest": {
              "$ref": "#/$defs/digest"
            },
            "artifactDigest": {
              "$ref": "#/$defs/digest"
            },
            "topologyDigest": {
              "$ref": "#/$defs/digest"
            },
            "runnerDigest": {
              "$ref": "#/$defs/digest"
            },
            "evaluationDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "evidenceTier", "authority"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
            },
            "evidenceTier": {
              "enum": ["T0", "T1", "T2", "T3"]
            },
            "authority": {
              "enum": ["AUTHORITATIVE", "SUPPORTING"]
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "releaseFrozen",
            "manualReviewRequired",
            "rollback",
            "statePreservation",
            "finalIdentity",
            "alreadyCurrent"
          ],
          "properties": {
            "status": {
              "enum": ["PASS", "FAIL", "BLOCKED"]
            },
            "releaseFrozen": {
              "type": "boolean"
            },
            "manualReviewRequired": {
              "type": "boolean"
            },
            "rollback": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "status"],
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "status": {
                  "enum": ["PASS", "N/A"]
                }
              }
            },
            "statePreservation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "status", "beforeDigest", "afterDigest"],
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "status": {
                  "enum": ["PASS", "N/A"]
                },
                "beforeDigest": {
                  "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
                },
                "afterDigest": {
                  "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
                }
              }
            },
            "finalIdentity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "commit", "tree", "artifactDigest"],
              "properties": {
                "version": {
                  "$ref": "#/$defs/version"
                },
                "commit": {
                  "$ref": "#/$defs/gitObject"
                },
                "tree": {
                  "$ref": "#/$defs/gitObject"
                },
                "artifactDigest": {
                  "$ref": "#/$defs/digest"
                }
              }
            },
            "alreadyCurrent": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "status"],
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "status": {
                  "enum": ["PASS", "N/A"]
                }
              }
            }
          }
        },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuedAt", "expiresAt"],
          "properties": {
            "issuedAt": {
              "type": "string",
              "format": "date-time"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "receiptDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit", "tree"],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "commit": {
          "$ref": "#/$defs/gitObject"
        },
        "tree": {
          "$ref": "#/$defs/gitObject"
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
