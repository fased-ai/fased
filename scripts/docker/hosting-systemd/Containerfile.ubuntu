FROM docker.io/library/ubuntu:24.04

ENV container=podman
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    acl \
    ca-certificates \
    curl \
    dbus \
    findutils \
    gawk \
    git \
    grep \
    iproute2 \
    jq \
    openssl \
    passwd \
    procps \
    sudo \
    systemd \
    tar \
    util-linux \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* \
  && systemctl mask \
    dev-hugepages.mount \
    sys-fs-fuse-connections.mount \
    systemd-remount-fs.service

COPY updater-request.mjs /usr/local/bin/fased-hosting-updater-request
RUN chmod 0755 /usr/local/bin/fased-hosting-updater-request

STOPSIGNAL SIGRTMIN+3
CMD ["/usr/lib/systemd/systemd"]
