FROM docker.io/library/ubuntu:24.04

ENV container=podman
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    dbus \
    curl \
    iproute2 \
    jq \
    openssl \
    passwd \
    procps \
    sudo \
    systemd \
    xz-utils \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* \
  && curl -fsSL https://nodejs.org/dist/v24.18.0/node-v24.18.0-linux-x64.tar.xz \
    | tar -xJ --strip-components=1 -C /usr/local \
  && chown root:root /usr/local/bin/node \
  && systemctl mask \
    dev-hugepages.mount \
    sys-fs-fuse-connections.mount \
    systemd-remount-fs.service

COPY run.sh /usr/local/bin/fased-protected-local-systemd-fixture
RUN chmod 0755 /usr/local/bin/fased-protected-local-systemd-fixture

STOPSIGNAL SIGRTMIN+3
CMD ["/usr/lib/systemd/systemd"]
