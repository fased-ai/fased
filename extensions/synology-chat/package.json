{
  "name": "@fased/synology-chat",
  "version": "0.1.76-rc.55",
  "description": "Synology Chat channel plugin for FasedAgent",
  "type": "module",
  "dependencies": {
    "zod": "^4.3.6"
  },
  "fased": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "synology-chat",
      "label": "Synology Chat",
