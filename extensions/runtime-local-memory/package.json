{
  "name": "@fased/local-memory-runtime",
  "version": "0.1.60",
  "description": "Optional local vector-memory runtime for Fased Agent",
  "files": [
    "index.ts",
    "fased.plugin.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "sqlite-vec": "0.1.7-alpha.2"
  },
  "peerDependencies": {
    "@fased/fased": "^0.1.60"
  },
  "peerDependenciesMeta": {
    "@fased/fased": {
      "optional": true
    }
  },
  "fased": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@fased/local-memory-runtime",
      "localPath": "extensions/runtime-local-memory",
      "defaultChoice": "npm"
    }
  }
}
