{
  "name": "@fased/local-memory-runtime",
  "version": "0.1.76-rc.118",
  "private": true,
  "description": "Optional local vector-memory runtime for Fased Agent",
  "files": [
    "index.ts",
    "fased.plugin.json"
  ],
  "type": "module",
  "dependencies": {
    "sqlite-vec": "0.1.7-alpha.2"
  },
  "peerDependencies": {
    "@fased/fased": "^0.1.76-rc.118"
  },
  "peerDependenciesMeta": {
    "@fased/fased": {
      "optional": true
    }
  },
  "fased": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "localPath": "extensions/runtime-local-memory",
      "defaultChoice": "local"
    }
  }
}
