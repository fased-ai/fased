  },
  "peerDependencies": {
    "@fased/fased": "^0.1.76-rc.84"
  },
  "peerDependenciesMeta": {
    "@fased/fased": {
      "optional": true
    }
  },
  "fased": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "localPath": "extensions/runtime-browser",
      "defaultChoice": "local"
    }
  }
