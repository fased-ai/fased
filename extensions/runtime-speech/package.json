{
  "name": "@fased/speech-runtime",
  "version": "0.1.46",
  "description": "Optional speech runtime for Fased Agent",
  "files": [
    "index.ts",
    "fased.plugin.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "node-edge-tts": "^1.2.10"
  },
  "peerDependencies": {
    "@fased/fased": "^0.1.46"
  },
  "peerDependenciesMeta": {
    "@fased/fased": {
      "optional": true
    }
  },
  "fased": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@fased/speech-runtime",
      "localPath": "extensions/runtime-speech",
      "defaultChoice": "npm"
    }
  }
}
