# Fased Agent hosted/federation env example
#
# Local installs do not need this file. Use it only when this agent should have
# a public network identity, join a federation server, or run managed hosted
# routing. Normal onboarding can set these values in fased.json instead.

# Public origin of THIS agent (or keep localhost for local-only testing)
FASED_A2A_ORIGIN=https://<your-agent-domain>

# Optional: explicit handle/id. If omitted, defaults are auto-derived:
# handle => @fased-agent-<nodeId12>@<federation-domain>
# agentId => <handle>
# FASED_A2A_HANDLE=@<agent-name>@<your-agent-domain>
# FASED_A2A_AGENT_ID=@<agent-name>@<your-agent-domain>

# Optional: name used by federation-join when handle is auto-generated
FASED_A2A_NAME=fased-agent

# Federation control-plane base URL (server)
# Default if omitted: https://ff1.fased.app
FASED_FEDERATION_BASE_URL=https://<your-federation-server-domain>

# Optional bootstrap token for restricted/private federation deployments.
# In normal public onboarding, leave unset and agent will auto challenge/enroll
# and persist a per-agent token under ~/.fased/federation/access-token.json.
# FASED_FEDERATION_API_TOKEN=<token>

# Enable/disable startup auto-connect (default: 1)
FASED_FEDERATION_AUTO_CONNECT=1

# Optional renew interval in ms (default: 2700000)
# FASED_FEDERATION_RENEW_INTERVAL_MS=2700000

# Optional AP bridge metadata switch
FASED_A2A_AP_BRIDGE_ENABLED=1

# === Managed Domain (zrok tunnel) ===
# Gateway mode: managed | byod | none (default: none)
#   managed = auto-tunnel via zrok (subdomain assigned by federation server)
#   byod    = use your own domain, skip zrok
#   none    = local only (default)
# FASED_GATEWAY_MODE=none

# Optional fallback URL if tunnel goes down
# FASED_FALLBACK_URL=

# zrok API endpoint (default: https://zrok.fased.app)
# Only override if using a different zrok hub
# ZROK_API_ENDPOINT=https://zrok.fased.app

# === Wallet Approval Auth (optional hardening) ===
# none    = no extra wallet approval token gate
# webauthn = require passkey verification for wallet approve/reset/rotate
# FASED_WALLET_APPROVAL_AUTH=webauthn

# Passkey challenge TTL in seconds (default 300)
# FASED_WALLET_APPROVAL_CHALLENGE_TTL_SECONDS=300

# Short-lived wallet action grant TTL in seconds (default 120)
# FASED_WALLET_APPROVAL_GRANT_TTL_SECONDS=120
